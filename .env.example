# When running the indexer as a docker-compose service, use the service names
# (postgres:5432, erpc:4000). When running the binary on the host, switch these
# back to localhost.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/parseon
HTTP_LISTEN=0.0.0.0:8080
RUST_LOG=info,parseon=debug
POLL_INTERVAL_MS=2000
DEFAULT_BATCH_SIZE=10
BLOCK_CACHE_SIZE=512
ERPC_URL=http://erpc:4000/main/evm
CHAIN_ID=1

# Grafana admin password (used by the grafana service in docker-compose.yml).
GRAFANA_ADMIN_PASSWORD=admin
