# Docker Compose overrides this host name for the indexer container. When
# running the binary on the host, use localhost as shown here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parseon
HTTP_LISTEN=0.0.0.0:8080
RUST_LOG=info,parseon=debug
POLL_INTERVAL_MS=2000
DEFAULT_BATCH_SIZE=10
BLOCK_CACHE_SIZE=512
RPC_URL=http://127.0.0.1:8545
